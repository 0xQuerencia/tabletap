    "shortcut": "super+pageup"
  },
  {
    "id": "kde.show_desktop",
    "label": "KDE · show desktop",
    "desktop": "kde",
    "argv": [
      "busctl",
      "--user",
      "call",
      "org.kde.kglobalaccel",
      "/component/kwin",
      "org.kde.kglobalaccel.Component",
      "invokeShortcut",
      "s",
      "Show Desktop"
    ]
  },
  {
    "id": "kde.krunner",
    "label": "KDE · open KRunner",
    "desktop": "kde",
    "argv": [
      "krunner"
    ]
  },
